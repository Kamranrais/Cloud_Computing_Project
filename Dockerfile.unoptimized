# ==========================================
# UNOPTIMIZED DOCKERFILE (BASELINE FOR TASK 5)
# Shows common anti-patterns:
# - Bloated full python base (includes git, gcc, dev libs)
# - Single-stage build leaving build artifacts
# - Root execution
# - Large build cache retained
# Resulting size: ~1.18GB
# ==========================================

FROM python:3.11

WORKDIR /app

COPY requirements.txt .

# Unoptimized single-run installation with full cache
RUN apt-get update && apt-get install -y build-essential curl wget git
RUN pip install -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
